{
  "info": {
    "name": "DevSu API",
    "description": "API para gestión de clientes, cuentas y movimientos bancarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.2.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar todos los clientes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clientes"
          }
        },
        {
          "name": "Obtener cliente por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clientes/1"
          }
        },
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/clientes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"genero\": \"M\",\n  \"edad\": 30,\n  \"identificacion\": \"9999999999\",\n  \"direccion\": \"Av. Principal 123\",\n  \"telefono\": \"0999999999\",\n  \"contrasena\": \"password123\",\n  \"estado\": true\n}"
            }
          }
        },
        {
          "name": "Actualizar cliente",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/clientes/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez Actualizado\",\n  \"genero\": \"M\",\n  \"edad\": 31,\n  \"identificacion\": \"0987654321\",\n  \"direccion\": \"Av. Secundaria 456\",\n  \"telefono\": \"0988888888\",\n  \"contrasena\": \"newpassword123\",\n  \"estado\": true\n}"
            }
          }
        },
        {
          "name": "Eliminar cliente",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/clientes/4"
          }
        }
      ]
    },
    {
      "name": "Cuentas",
      "item": [
        {
          "name": "Listar todas las cuentas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cuentas"
          }
        },
        {
          "name": "Obtener cuenta por número",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cuentas/478758"
          }
        },
        {
          "name": "Crear cuenta",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/cuentas",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"999999\",\n  \"tipoCuenta\": \"Ahorros\",\n  \"saldoInicial\": 2000,\n  \"clienteId\": 1,\n  \"estado\": true\n}"
            }
          }
        },
        {
          "name": "Actualizar cuenta",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/cuentas/478758",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"tipoCuenta\": \"Corriente\",\n  \"saldoInicial\": 2500,\n  \"clienteId\": 1,\n  \"estado\": true\n}"
            }
          }
        },
        {
          "name": "Eliminar cuenta",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/cuentas/999999"
          }
        }
      ]
    },
    {
      "name": "Movimientos",
      "item": [
        {
          "name": "Listar todos los movimientos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movimientos"
          }
        },
        {
          "name": "Crear depósito (crédito)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/movimientos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"movimiento\": 500\n}"
            }
          }
        },
        {
          "name": "Crear retiro (débito)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/movimientos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"movimiento\": -200\n}"
            }
          }
        },
        {
          "name": "ERROR: Retiro sin saldo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/movimientos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"movimiento\": -5000\n}"
            }
          }
        },
        {
          "name": "ERROR: Cupo diario excedido",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/movimientos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"movimiento\": -600\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "Generar estado de cuenta",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reportes",
              "host": ["{{baseUrl}}", "reportes"],
              "query": [
                {
                  "key": "clienteId",
                  "value": "1"
                },
                {
                  "key": "fechaInicio",
                  "value": "2024-01-01"
                },
                {
                  "key": "fechaFin",
                  "value": "2024-12-31"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}