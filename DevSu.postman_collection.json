{
  "info": {
    "_postman_id": "devsu-local-collection",
    "name": "DevSu API",
    "description": "API para gestión de clientes, cuentas y movimientos bancarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar todos los clientes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes"]
            }
          }
        },
        {
          "name": "Obtener cliente por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clientes/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "1"]
            }
          }
        },
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"genero\": \"M\",\n  \"edad\": 30,\n  \"identificacion\": \"9999999999\",\n  \"direccion\": \"Av. Principal 123\",\n  \"telefono\": \"0999999999\",\n  \"contrasena\": \"password123\",\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes"]
            }
          }
        },
        {
          "name": "Actualizar cliente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez Actualizado\",\n  \"genero\": \"M\",\n  \"edad\": 31,\n  \"identificacion\": \"0987654321\",\n  \"direccion\": \"Av. Secundaria 456\",\n  \"telefono\": \"0988888888\",\n  \"contrasena\": \"newpassword123\",\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/clientes/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "1"]
            }
          }
        },
        {
          "name": "Eliminar cliente",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/clientes/4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "4"]
            }
          }
        }
      ]
    },
    {
      "name": "Cuentas",
      "item": [
        {
          "name": "Listar todas las cuentas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cuentas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cuentas"]
            }
          }
        },
        {
          "name": "Obtener cuenta por número",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cuentas/478758",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cuentas", "478758"]
            }
          }
        },
        {
          "name": "Crear cuenta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"999999\",\n  \"tipoCuenta\": \"Ahorros\",\n  \"saldoInicial\": 2000,\n  \"clienteId\": 1,\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cuentas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cuentas"]
            }
          }
        },
        {
          "name": "Actualizar cuenta",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"tipoCuenta\": \"Corriente\",\n  \"saldoInicial\": 2500,\n  \"clienteId\": 1,\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cuentas/478758",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cuentas", "478758"]
            }
          }
        },
        {
          "name": "Eliminar cuenta",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/cuentas/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cuentas", "999999"]
            }
          }
        }
      ]
    },
    {
      "name": "Movimientos",
      "item": [
        {
          "name": "Listar todos los movimientos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/movimientos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movimientos"]
            }
          }
        },
        {
          "name": "Crear depósito (crédito)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"movimiento\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/movimientos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movimientos"]
            }
          }
        },
        {
          "name": "Crear retiro (débito)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"movimiento\": -200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/movimientos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movimientos"]
            }
          }
        },
        {
          "name": "ERROR: Retiro sin saldo disponible",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"movimiento\": -5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/movimientos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movimientos"]
            }
          }
        },
        {
          "name": "ERROR: Cupo diario excedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"movimiento\": -600\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/movimientos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movimientos"]
            }
          }
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "Generar estado de cuenta PDF",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reportes?clienteId=1&fechaInicio=2024-01-01&fechaFin=2024-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reportes"],
              "query": [
                {
                  "key": "clienteId",
                  "value": "1"
                },
                {
                  "key": "fechaInicio",
                  "value": "2024-01-01"
                },
                {
                  "key": "fechaFin",
                  "value": "2024-12-31"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}